# ==============================================================
# CivicResolve - Environment Configuration
# ==============================================================

# Flask Secret Key for Session Cryptography and CSRF Protection
# Generate a strong key for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=civicresolve-super-secret-key-hackathon-2026

# Municipal Staff Administrator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Optional: Store pre-computed Werkzeug scrypt/pbkdf2 hash instead of plaintext
# ADMIN_PASSWORD_HASH=

# Google Gemini API Key (Optional)
# Leave blank to operate in 100% offline Demo Mode (Rule-Based AI).
# To enable Gemini 2.5 Flash, get a key from https://aistudio.google.com
GEMINI_API_KEY=

# Server Port (Google Cloud Run automatically sets PORT=8080)
PORT=5000

# Security: Set to True when deploying behind HTTPS (Cloud Run, TLS)
SESSION_COOKIE_SECURE=False

# Database location (defaults to civicresolve.db in project root)
# DATABASE_PATH=civicresolve.db
